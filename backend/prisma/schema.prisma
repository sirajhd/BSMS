datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SHOP_OWNER
  MANAGER
  BARBER
  CUSTOMER
  ADMIN // Maintained for backward compatibility with legacy references
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  LATE
  NO_SHOW
  RESCHEDULED
}

enum PaymentMethod {
  ONLINE
  PAY_AT_SHOP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  STATUS_CHANGED
  LATE_STATUS
  NO_SHOW_STATUS
  SYSTEM_ALERT
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  email     String?
  phone     String?
  address   String?
  logo      String?
  status    TenantStatus @default(ACTIVE)
  timezone  String       @default("UTC")
  currency  String       @default("ETB")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  settings          TenantSettings?
  memberships       Membership[]
  services          Service[]
  businessSchedules BusinessSchedule[]
  barbers           Barber[]
  customerProfiles  CustomerProfile[]
  appointments      Appointment[]
  payments          Payment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  subscriptions     Subscription[]

  @@index([slug])
  @@index([status])
}

model TenantSettings {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  primaryColor           String   @default("#d97706") // Amber-600 default
  secondaryColor         String   @default("#0f172a") // Slate-900 default
  bookingNoticeHours     Int      @default(1)
  maxAdvanceBookingDays  Int      @default(30)
  cancellationCutoffHours Int     @default(2)
  allowWalkIns           Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER) // Platform/default role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  customerProfile CustomerProfile?
  barberProfile   Barber?
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role])
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([role])
}

model CustomerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  tenantId     String?
  fullName     String
  phone        String
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([userId])
  @@index([tenantId])
}

model Barber {
  id           String   @id @default(uuid())
  userId       String   @unique
  tenantId     String?
  fullName     String
  phone        String
  profileImage String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  availability BarberAvailability[]
  appointments Appointment[]

  @@index([userId])
  @@index([tenantId])
  @@index([isActive])
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String?
  name            String
  description     String
  price           Float    // Stored as ETB
  durationMinutes Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
}

model BusinessSchedule {
  id        String   @id @default(uuid())
  tenantId  String?
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  isOpen    Boolean  @default(true)
  openTime  String   // e.g. "08:30" (24h HH:mm)
  closeTime String   // e.g. "19:30" (24h HH:mm)

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model BarberAvailability {
  id        String   @id @default(uuid())
  barberId  String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   // e.g. "09:00"
  endTime   String   // e.g. "17:00"

  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

model Appointment {
  id                      String            @id @default(uuid())
  tenantId                String?
  customerId              String
  barberId                String
  serviceId               String
  appointmentDate         String            // e.g. "2026-10-02"
  startTime               String            // e.g. "10:30"
  endTime                 String            // e.g. "11:00"
  startAt                 DateTime          // Timestamp for exact conflict and overlap queries
  endAt                   DateTime          // Timestamp for exact conflict and overlap queries
  status                  AppointmentStatus @default(CONFIRMED)
  paymentMethod           PaymentMethod     @default(PAY_AT_SHOP)
  paymentStatus           PaymentStatus     @default(PENDING)
  notes                   String?

  // Snapshot fields at booking time to preserve historical integrity
  serviceNameSnapshot     String
  servicePriceSnapshot    Float
  serviceDurationSnapshot Int

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  tenant                  Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  barber                  Barber            @relation(fields: [barberId], references: [id], onDelete: Restrict)
  service                 Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payments                Payment[]

  @@index([tenantId])
  @@index([customerId])
  @@index([barberId])
  @@index([serviceId])
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, appointmentDate])
  @@index([tenantId, status])
}

model Payment {
  id                   String        @id @default(uuid())
  tenantId             String?
  appointmentId        String
  amount               Float         // ETB
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  provider             String        @default("MANUAL") // "GREY", "MANUAL", etc.
  transactionReference String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant               Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment          Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appointmentId])
  @@index([tenantId, status])
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String?
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  tenant    Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
}

model Plan {
  id                     String         @id @default(uuid())
  name                   String
  slug                   String         @unique
  description            String?
  price                  Float          // In ETB or USD base
  interval               PlanInterval   @default(MONTHLY)
  maxBarbers             Int            @default(5)
  maxMonthlyAppointments Int            @default(500)
  features               String?        // JSON or comma separated feature keys
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  subscriptions          Subscription[]

  @@index([slug])
  @@index([isActive])
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  actorUserId String?
  action      String   // e.g. "TENANT_CREATED", "APPOINTMENT_CANCELLED", "ROLE_UPDATED"
  entity      String   // e.g. "Appointment", "Tenant", "User"
  entityId    String?
  metadata    String?  // JSON formatted details of the change
  ipAddress   String?
  createdAt   DateTime @default(now())

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}
