# ==============================================================================
# BSMS Multi-Tenant SaaS Platform - Docker Compose & Environment Template
# ==============================================================================
# Copy this file to '.env' at the repository root before running 'docker compose up':
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=barber_shop_db

# ------------------------------------------------------------------------------
# 2. Backend API & Security Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# JSON Web Token Secret (MUST be at least 32 characters long in production)
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARACTER_JWT_SECRET_KEY_FOR_PRODUCTION_SECURITY

# Upload Directory for multi-tenant static file assets
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# 3. Domain & Tenant Routing Configuration
# ------------------------------------------------------------------------------
# Apex domain URL for your production platform (e.g. https://yourdomain.com or http://localhost)
FRONTEND_URL=https://yourdomain.com
